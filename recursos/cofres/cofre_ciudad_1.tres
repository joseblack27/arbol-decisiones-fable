[resource]
script = ExtResource("1_scr")
id = "cofre_ciudad_1"
nombre = "Cofre de la Ciudad"
tabla_botin = Array[ExtResource("2_loot")]([SubResource("Resource_pocion"), SubResource("Resource_hoja")])
